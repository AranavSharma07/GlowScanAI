# Add a server-side vision-capable OpenAI API key before using real AI analysis.
# Never put secret keys in NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# Public leaderboard (server-side only; never use NEXT_PUBLIC_ for these secrets)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
GLOWSCAN_LEADERBOARD_SECRET=replace-with-a-long-random-secret-at-least-32-characters
